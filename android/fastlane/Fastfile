default_platform :android

platform :android do
  private_lane :write_google_services do
    path = File.join(File.expand_path('..', Dir.pwd), "app/google-services.json")
    json = ENV["GOOGLE_SERVICES_JSON"]
    if json && !json.empty?
      File.write(path, json)
    elsif !File.file?(path)
      UI.user_error!("Missing android/app/google-services.json and GOOGLE_SERVICES_JSON")
    end
  end

  desc "Build the Android release APK for the GitHub Release"
  lane :build_android_apk do
    write_google_services

    # flavor: "prod" is MANDATORY — task: "assemble" is a gradle meta-task
    # that, post-flavor, would build both prodRelease AND e2eRelease
    # (variantFilter kills e2eRelease but the meta-task would still run
    # through both flavors' dependency graphs). Pinning the flavor makes
    # the invocation unambiguous and halves CI time.
    gradle(
      task: "assemble",
      flavor: "prod",
      build_type: "Release",
      print_command: false
    )
  end
end
